"""
{{ dag.description | default(value="Generated from Control-M by Airflow Enterprise Toolkit") }}

This DAG was automatically generated from Control-M jobs using the Airflow Enterprise Toolkit.
Original jobs: {{ tasks | length }}
"""

# Import Control-M base classes for enterprise features
try:
    from airflow_enterprise_toolkit.dag_base import ControlMDAG, OrderDateStrategy, HoldCondition
except ImportError:
    # Fallback if enterprise toolkit is not installed
    from airflow import DAG
    ControlMDAG = DAG
    OrderDateStrategy = None
    HoldCondition = None

from airflow.macros import ds_add
from airflow.operators.bash import BashOperator
from airflow.operators.dummy import DummyOperator
from airflow.sensors.filesystem import FileSensor
from airflow.sensors.external_task import ExternalTaskSensor
from datetime import datetime, timedelta

# DAG definition
default_args = {
    'owner': 'airflow',
    'depends_on_past': False,
    'start_date': {{ dag.start_date | date(format="%Y, %m, %d") }},
    'email_on_failure': False,
    'email_on_retry': False,
    'retries': 1,
    'retry_delay': timedelta(minutes=5),
}

{%- if dag.config.default_args %}
# Custom default arguments from Control-M
{%- for key, value in dag.config.default_args %}
default_args['{{ key }}'] = {{ value }}
{%- endfor %}
{%- endif %}

# Use Control-M enhanced DAG if available
if ControlMDAG and ControlMDAG != DAG:
    # Enhanced DAG with Control-M features
    dag = ControlMDAG(
        '{{ dag.dag_id }}',
        default_args=default_args,
        description="{{ dag.description | default(value='Control-M migration DAG') }}",
        schedule_interval='{{ dag.schedule_interval }}',
        catchup=False,
        tags={{ tags_safe }},
        max_active_runs={{ dag.config.max_active_runs | default(value=1) }},
        is_paused={{ is_paused_str }},
        # Control-M specific configurations
        order_date_strategy=OrderDateStrategy.CURRENT,  # Default to current order date
        enable_hold_conditions=True,  # Enable Control-M hold conditions
        enable_skip_conditions=True,  # Enable Control-M skip conditions
        retain_order_date=True,  # Retain Control-M order date behavior
    )
else:
    # Fallback to standard Airflow DAG
    with DAG(
        '{{ dag.dag_id }}',
        default_args=default_args,
        description="{{ dag.description | default(value='Control-M migration DAG') }}",
        schedule_interval='{{ dag.schedule_interval }}',
        catchup=False,
        tags={{ tags_safe }},
        max_active_runs={{ dag.config.max_active_runs | default(value=1) }},
        is_paused={{ is_paused_str }},
    ) as dag:
        # Task definitions
        {%- for task_def in task_definitions %}
{{ task_def }}
        {%- endfor %}

        # Task dependencies
        {%- for dep in dependencies %}
{{ dep }}
        {%- endfor %}

{%- if ControlMDAG and ControlMDAG != DAG %}
# Task definitions with Control-M enhancements
{%- for task_def in task_definitions %}
{{ task_def }}
{%- endfor %}

# Task dependencies
{%- for dep in dependencies %}
{{ dep }}
{%- endfor %}

